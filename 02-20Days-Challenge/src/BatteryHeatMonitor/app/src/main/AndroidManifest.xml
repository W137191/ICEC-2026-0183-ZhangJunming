<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 前台服务：让监测在熄屏/切到其它 App（刷视频、打游戏）时仍能持续采样 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 前台服务类型：本地数据记录归类为 dataSync（API 34+ 必须持有此权限，不能限 maxSdkVersion） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 通知权限：Android 13+ 显示保活通知需要（同理不能限 maxSdkVersion） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 唤醒锁：熄屏时保持 CPU 运行以按时采样 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 项目三声振采集：录制麦克风音频 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BatteryHeatMonitor">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 项目三：声振采集（手机麦克风 + 加速度计） -->
        <activity
            android:name=".sensing.SensingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 课题06：噪声测量（导出 dB 时间序列，替代市面分贝仪截图） -->
        <activity
            android:name=".sensing.NoiseActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- CSV 安全分享（避免直接暴露文件路径） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
